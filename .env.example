# API Base URL for FemmeFlo Backend (port 5000 local dev server)
# Reachability targets:
# - Physical devices on local Wi-Fi: use your computer's LAN IPv4 address (e.g. http://192.168.0.106:5000/api/v1)
# - Standard Android Emulator: use http://10.0.2.2:5000/api/v1 (maps to host localhost)
# - Port forwarding: run `adb reverse tcp:5000 tcp:5000` to access via http://localhost:5000/api/v1
EXPO_PUBLIC_API_URL=http://192.168.0.106:5000/api/v1

# Standalone UI Testing Mode (Set to 'true' only for frontend-only offline development without backend)
EXPO_PUBLIC_USE_MOCK_API=false
