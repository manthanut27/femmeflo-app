# Standalone UI Testing Mode (App-only with no backend)
# Set to 'true' to run the app standalone with in-memory mock data
# Set to 'false' to connect to a real backend server
EXPO_PUBLIC_USE_MOCK_API=true

# API Base URL for FemmeFlo Backend (used only when EXPO_PUBLIC_USE_MOCK_API=false)
# Connected to local femmeflo-yfa-inventory-server:
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# For remote Render backend:
# EXPO_PUBLIC_API_URL=https://femmeflo-inventory.onrender.com/api/v1

# For physical device testing over LAN (replace with host machine IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api/v1
